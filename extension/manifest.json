{
  "manifest_version": 3,
  "name": "TrustShell stamp",
  "version": "1.0.0",
  "description": "Reads the last assistant reply and stamps pass, veto, or not-checked.",
  "host_permissions": [
    "https://repid-engine-production.up.railway.app/*"
  ],
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["toast.js", "laya.js", "classify.js", "content.js"],
      "css": ["stamp.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["laya.js", "classify.js", "grok.js"],
      "css": ["stamp.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["toast.js", "laya.js", "classify.js", "claude.js"],
      "css": ["stamp.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["toast.js", "laya.js", "classify.js", "gemini.js"],
      "css": ["stamp.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://deepseek.com/*", "https://chat.deepseek.com/*"],
      "js": ["toast.js", "laya.js", "classify.js", "deepseek.js"],
      "css": ["stamp.css"],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "TrustShell stamp",
  "version": "1.0.0",
  "description": "Reads the last assistant reply and stamps pass, veto, or not-checked.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["stamp.css"],
      "run_at": "document_idle"
    }
  ]
}

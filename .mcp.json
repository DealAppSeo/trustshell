{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "trustshell": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@hyperdag/trustshell@1.9.1",
        "trustshell-mcp"
      ]
    },
    "zvec-grep": {
      "type": "stdio",
      "command": "zg",
      "args": [
        "server",
        "--stdio",
        "--mcp-toolset",
        "agent"
      ]
    }
  }
}

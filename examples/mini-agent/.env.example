# HyperDAG Mini-Agent — Environment Variables
# Copy this file to .env and fill in your values.
# One-line setup: cp .env.example .env && vim .env

# ── Required for live LLM calls ────────────────────────────────────────────
# Get a free Groq API key at: https://console.groq.com (no credit card needed)
# Free tier: 30 req/min, 14400 req/day — plenty for dev/demo.
GROQ_API_KEY=

# ── Optional overrides ─────────────────────────────────────────────────────
# Override to point at a local repid-engine instance (default: Railway prod)
TRUSTSHELL_API_URL=https://repid-engine-production.up.railway.app

# The repid_agents.agent_id to use for RepID + ZKP proof lookups.
# Any active Trinity agent works (trinity-sophia, trinity-orch, trinity-veritas, etc.)
# trinity-shofet UUID (repid_agents.id — must be UUID, not agent_name)
AGENT_ID=32e0e809-c1c4-4405-913f-135c8a2d6626

# Set to a real ERC-8004 token ID to do a live on-chain identity lookup on Base Sepolia.
# Example: 1585 (APM), 7 (shofet), etc.
# Leave blank to skip on-chain lookup (shows the registration path comment instead).
ERC8004_TOKEN_ID=


{
  "name": "@hyperdag/trustshell",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Constitutional trust infrastructure for AI agents. Wrap your LLM agent, earn verifiable on-chain reputation through Plonky3 ZKPs and ERC-8004.",
  "keywords": [
    "ai-agents",
    "erc-8004",
    "zkp",
    "reputation",
    "plonky3",
    "trust-layer",
    "agent-identity",
    "web3",
    "verifiable-ai",
    "hal",
    "hallucination",
    "constitutional-ai",
    "hyperdag",
    "repid"
  ],
  "homepage": "https://trustshell.dev",
  "bugs": {
    "url": "https://github.com/DealAppSeo/trustshell/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DealAppSeo/trustshell.git"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trustshell-verify-demo": "dist/cli/verify-demo.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "test": "jest",
    "verify-demo": "node ./dist/cli/verify-demo.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@hyperdag/proof-verifier": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  }
}

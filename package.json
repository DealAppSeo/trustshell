{
  "name": "@hyperdag/trustshell",
  "version": "1.3.0",
  "description": "Trust SDK for AI agents \u2014 HAL hallucination filtering, portable RepID, and agent-to-agent service purchase with verifiable receipts, against the live HyperDAG backend.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "trustshell": "dist/cli/index.js",
    "hal": "dist/cli/index.js",
    "trustshell-mcp": "dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sdk:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "sdk:build": "npm run sdk:clean && tsc --project tsconfig.sdk.json",
    "sdk:test": "jest --testPathIgnorePatterns /node_modules/ tests/e2e/ --passWithNoTests",
    "test:wrapper-readiness": "jest tests/e2e/wrapper-readiness.test.ts",
    "prepublishOnly": "npm run sdk:build && npm run sdk:test",
    "test:grants-fail-closed": "node tests/e2e/grants-fail-closed.mjs",
    "test:mvp-walk": "node tests/e2e/mvp-walk.mjs",
    "test:campaign-honesty": "node tests/e2e/campaign-honesty.mjs",
    "test:roles-honesty": "node tests/e2e/roles-honesty.mjs",
    "test:acceptance": "node tests/e2e/harness-acceptance.mjs",
    "test:acceptance-baseline": "node tests/e2e/acceptance-baseline.mjs"
  },
  "comment:deps": "DEPENDENCY DIET 2026-06-15: the SDK (src/lib/) imports NONE of next/react/supabase/lucide/idb \u2014 they are Next.js-APP baggage that SDK consumers were inheriting (puppeteer/sharp/googleapis arrive transitively via next, ~1898 pkgs / ~7min install). The published package ships only dist/ (files[]), so the only true SDK runtime dep is @hyperdag/proof-verifier (dynamically imported, fails gracefully). App-runtime deps moved to devDependencies \u2192 they are still installed for `next build`/dev (full install), but `npm install @hyperdag/trustshell` no longer pulls the Next.js tree. NOTE: this confirms the SDK should ultimately be its OWN package (also resolves the merge-base caveat) \u2014 flagged for Sean.",
  "dependencies": {
    "@hyperdag/proof-verifier": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ethers": "^6.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "idb-keyval": "^6.2.2",
    "jest": "^29",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "ts-jest": "^29",
    "typescript": "^5"
  }
}

{
  "name": "@hyperdag/trustshell",
  "version": "0.4.1",
  "description": "Trust scoring SDK for AI — add HAL evaluation to any LLM app in 3 lines.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sdk:build": "tsc --project tsconfig.sdk.json",
    "sdk:test": "jest --testPathPattern=trustshell --passWithNoTests",
    "prepublishOnly": "npm run sdk:build && npm run sdk:test"
  },
  "dependencies": {
    "@hyperdag/proof-verifier": "^0.2.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "jest": "^29",
    "tailwindcss": "^4",
    "ts-jest": "^29",
    "typescript": "^5"
  }
}

{
  "name": "@hyperdag/trustshell",
  "version": "1.0.0",
  "description": "Trust scoring SDK for AI — add HAL evaluation to any LLM app in 3 lines. Includes TypeScript + Python clients, CLI, and framework integrations.",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build && echo 'Next app built. For SDK: tsc -p tsconfig.sdk.json'",
    "start": "next start",
    "lint": "eslint",
    "sdk:build": "tsc --project tsconfig.sdk.json",
    "sdk:test": "jest --preset ts-jest --testPathPattern=tests/trustshell.test.ts",
    "prepublishOnly": "npm run sdk:build && npm run sdk:test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "ethers": "^6.16.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "jest": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.2",
    "typescript": "^5"
  }
}
